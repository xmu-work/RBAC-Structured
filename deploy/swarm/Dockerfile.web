# 前端镜像（构建上下文 = 仓库根目录 RBAC-Structured/）
#   docker build -f deploy/swarm/Dockerfile.web -t <registry>/iam-web:1.0.0 .
# 构建读取 web/.env.production：VITE_API_BASE=/api/v1，生产走同源 /api/v1。

FROM node:20-alpine AS build
WORKDIR /build
RUN npm install -g pnpm@9
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

FROM nginx:1.27-alpine
COPY deploy/swarm/nginx-default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html
EXPOSE 80
